{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SafeHome",
  "version": "0.1.0",
  "identifier": "com.guaspos.safehome",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SafeHome - Videovigilancia",
        "width": 1100,
        "height": 700,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob: http://127.0.0.1:8765 ws://127.0.0.1:8765; connect-src 'self' blob: http://127.0.0.1:8765 ws://127.0.0.1:8765; img-src 'self' data: blob: http://127.0.0.1:8765; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "python-backend/**/*",
      "python-backend/.venv/**/*"
    ]
  },
  "plugins": {
    "shell": {
      "allowlist": [
        {
          "name": "python-backend",
          "sidecar": true
        }
      ]
    }
  }
}